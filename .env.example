# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in every value.
# Run: node scripts/generate-secrets.cjs  to auto-generate secrets.
# NEVER commit .env to git.
# ============================================================

# ── Database ──────────────────────────────────────────────
# Use a managed PostgreSQL service in production (AWS RDS, Supabase, Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/grievance_db

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL=https://your-production-domain.gov.in
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── App ───────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://your-production-domain.gov.in

# ── WhatsApp Outbound ─────────────────────────────────────
# Set WHATSAPP_PROVIDER to: gupshup | twilio | meta | stub
WHATSAPP_PROVIDER=stub

# Webhook secret — used to verify inbound webhook calls from your provider
# Generate with: node scripts/generate-secrets.cjs
WHATSAPP_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Gupshup (if WHATSAPP_PROVIDER=gupshup)
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=
# GUPSHUP_SRC_PHONE=91XXXXXXXXXX

# Twilio (if WHATSAPP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Cloud API (if WHATSAPP_PROVIDER=meta)
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=

# ── File Upload / Storage ─────────────────────────────────
# Leave blank to use local disk (dev only).
# Set all three for S3 in production.
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=ap-south-1
# AWS credentials are read from IAM role (EC2/ECS) or ~/.aws/credentials
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here — use IAM roles.

# ── Cron Job ──────────────────────────────────────────────
# Generate with: node scripts/generate-secrets.cjs
CRON_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── AI / Gemini ───────────────────────────────────────────
# GEMINI_API_KEY=
