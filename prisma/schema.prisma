generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  passwordHash         String
  role                 Role                    @default(PUBLIC)
  phone                String?                 @db.VarChar(32)
  status               String?                 @default("active")
  language             String?                 @default("en")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  auditLogs            AuditLog[]
  calendarEvents       CalendarEvent[]
  assignedProjects     GovernmentProject[]     @relation("ProjectAssignedTo")
  governmentProjects   GovernmentProject[]
  assignedGrievances   Grievance[]             @relation("AssignedToUser")
  statusUpdates        GrievanceStatusUpdate[]
  assignedIndividuals  IndividualGrievance[]   @relation("IndividualAssignedTo")
  individualGrievances IndividualGrievance[]
  assignedJobs         JobRequest[]            @relation("JobAssignedTo")
  jobRequests          JobRequest[]
  notifications        Notification[]
  assignedPatients     PatientGrievance[]      @relation("PatientAssignedTo")
  patientGrievances    PatientGrievance[]
  projectStatusUpdates ProjectStatusUpdate[]
  assignedTTDs         TTDRequest[]            @relation("TTDAssignedTo")
  ttdRequests          TTDRequest[]
  handledPetitions     PetitionRequest[]       @relation("HandlingPA")
  assignedPetitions    PetitionRequest[]       @relation("AssignedOfficial")
  handledWorks         PublicWork[]            @relation("WorkHandlingPA")
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  color       String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  grievances  Grievance[]
}

model Grievance {
  id                     String                  @id @default(cuid())
  referenceNumber        String                  @unique @default("TEMP-GRV-0000")
  title                  String
  description            String
  status                 GrievanceStatus         @default(PENDING)
  priority               Priority                @default(MEDIUM)
  requesterName          String                  @default("Unknown Requester")
  requesterPhone         String                  @default("+910000000000") @db.VarChar(32)
  requesterEmail         String?
  requesterAddress       String?
  village                String?
  mandal                 String?
  district               String?
  state                  String?                 @default("Telangana")
  pincode                String?
  latitude               Float?
  longitude              Float?
  grievanceCategory      GrievanceCategory       @default(OTHER)
  requestOrigin          RequestOrigin           @default(VILLAGE)
  intakeMethod           IntakeMethod            @default(ONLINE)
  estimatedCost          Float?
  expectedResolutionDate DateTime?
  actualResolutionDate   DateTime?
  remarks                String?
  assignedBy             String?
  assignedAt             DateTime?
  lastActionDate         DateTime?               @default(now())
  qrCode                 String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  categoryId             String?
  assignedToId           String?
  attachments            Attachment[]
  assignedTo             User?                   @relation("AssignedToUser", fields: [assignedToId], references: [id])
  category               Category?               @relation(fields: [categoryId], references: [id])
  statusUpdates          GrievanceStatusUpdate[]
  visitorLogs            VisitorLog[]
}

model Attachment {
  id           String    @id @default(cuid())
  fileName     String
  originalName String
  url          String
  mimeType     String
  fileSize     Int
  grievanceId  String
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  grievance    Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
}

model GrievanceStatusUpdate {
  id          String           @id @default(cuid())
  grievanceId String
  userId      String
  oldStatus   GrievanceStatus?
  newStatus   GrievanceStatus
  remarks     String?
  createdAt   DateTime         @default(now())
  grievance   Grievance        @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  userId     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  userId    String
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model GovernmentProject {
  id                     String                @id @default(cuid())
  referenceNumber        String                @unique @default("TEMP-PRJ-0000")
  projectName            String
  description            String?
  ministerName           String
  status                 ProjectStatus
  estimatedCost          Float?
  actualCost             Float?
  startDate              DateTime?
  completionDate         DateTime?
  village                String?
  mandal                 String?
  district               String?
  state                  String                @default("Telangana")
  beneficiaries          Int?
  remarks                String?
  attachments            Json?
  approvalDate           DateTime?
  sanctionOrder          String?
  contractAssignment     String?
  documents              Json?
  expectedCompletionDate DateTime?
  assignedToId           String?
  assignedBy             String?
  assignedAt             DateTime?
  createdBy              String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  assignedTo             User?                 @relation("ProjectAssignedTo", fields: [assignedToId], references: [id])
  createdByUser          User                  @relation(fields: [createdBy], references: [id])
  statusUpdates          ProjectStatusUpdate[]
  visitorLogs            VisitorLog[]
}

model PatientGrievance {
  id               String   @id @default(cuid())
  referenceNumber  String   @unique @default("TEMP-PAT-0000")
  patientName      String
  patientPhone     String
  village          String?
  caretakerName    String?
  caretakerPhone   String?
  issue            String
  hospital         String?
  doctor           String?
  referredByName   String?
  referredByNumber String?
  status           String   @default("NEW")
  assignedToId     String?
  qrCode           String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assignedTo       User?    @relation("PatientAssignedTo", fields: [assignedToId], references: [id])
  createdByUser    User     @relation(fields: [createdBy], references: [id])
}

model IndividualGrievance {
  id               String   @id @default(cuid())
  name             String
  mobileNumber     String
  village          String?
  contactName      String?
  contactNumber    String?
  office           String?
  subject          String
  referredByName   String?
  referredByNumber String?
  assignedToId     String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assignedTo       User?    @relation("IndividualAssignedTo", fields: [assignedToId], references: [id])
  createdByUser    User     @relation(fields: [createdBy], references: [id])
}

model JobRequest {
  id               String   @id @default(cuid())
  name             String
  mobileNumber     String
  village          String?
  contactName      String?
  contactNumber    String?
  office           String?
  subject          String
  referredByName   String?
  referredByNumber String?
  assignedToId     String?
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  assignedTo       User?    @relation("JobAssignedTo", fields: [assignedToId], references: [id])
  createdByUser    User     @relation(fields: [createdBy], references: [id])
}

model TTDRequest {
  id                String    @id @default(cuid())
  darshanDate       DateTime
  darshanType       String
  accommodationFrom DateTime?
  accommodationTo   DateTime?
  guests            Json
  referenceName     String?
  referenceNumber   String?
  referenceVillage  String?
  referenceMandal   String?
  assignedToId      String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  assignedTo        User?     @relation("TTDAssignedTo", fields: [assignedToId], references: [id])
  createdByUser     User      @relation(fields: [createdBy], references: [id])
}

model VisitorLog {
  id                String             @id @default(cuid())
  tokenNumber       String             @unique // e.g. VIS-2026-0001 — daily token
  visitorName       String
  visitorPhone      String?            @db.VarChar(32)
  visitorAadhar     String?            // masked, last 4 digits only in display
  visitorAddress    String?
  organization      String?            // delegation / party / dept
  visitType         VisitType          @default(WALK_IN)
  purpose           String
  appointmentDate   DateTime           @default(now())
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  meetingWith       String?            // officer/staff name they met
  status            VisitorStatus      @default(WAITING)
  outcomeNotes      String?            // what was decided / action taken
  priorityFlag      Boolean            @default(false) // VIP / urgent flag
  // Links
  grievanceId       String?
  projectId         String?
  petitionId        String?            // link to PetitionRequest
  loggedById        String?            // staff who logged this visitor
  // Audit
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  grievance         Grievance?         @relation(fields: [grievanceId], references: [id])
  project           GovernmentProject? @relation(fields: [projectId], references: [id])
}

enum VisitType {
  WALK_IN
  APPOINTMENT
  VIP
  DELEGATION
  MEDIA
  OFFICIAL
}

enum VisitorStatus {
  WAITING
  IN_MEETING
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ProjectStatusUpdate {
  id          String            @id @default(cuid())
  projectId   String
  userId      String
  oldStatus   ProjectStatus?
  newStatus   ProjectStatus
  remarks     String?
  attachments Json?
  createdAt   DateTime          @default(now())
  project     GovernmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id])
}

model WhatsAppMessage {
  id          String    @id @default(cuid())
  phone       String
  message     String
  rawText     String
  isProcessed Boolean   @default(false)
  grievanceId String?
  // ── MEDIA ATTACHMENTS ──────────────────────────────────────────────────
  mediaUrl    String?   // URL of image/doc/audio sent by citizen
  mediaType   String?   // image | document | audio | video
  mediaCaption String?  // Caption the citizen sent with the media
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startDate     DateTime
  endDate       DateTime?
  location      String?
  attendees     Json?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdByUser User      @relation(fields: [createdBy], references: [id])
}

enum Role {
  ADMIN
  OFFICER
  PUBLIC
  MINISTER
  PA
  FIELD_OFFICER
  BACK_OFFICER
  GOVERNMENT_OFFICIAL
  LOCAL_LEADER
}

enum GrievanceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  UNDER_REVIEW
  RESOLVED
  CLOSED
  REJECTED
  WIP
}

enum GrievanceCategory {
  HEALTH
  JOBS
  CIVIL_WORK
  COLLECTIVE_REQUEST
  CM_FUND
  EDUCATION
  AGRICULTURE
  INFRASTRUCTURE
  SOCIAL_WELFARE
  TTD_SERVICES
  PUBLIC_SERVICES
  OTHER
}

enum RequestOrigin {
  VILLAGE
  MANDAL
  DISTRICT
  STATE
}

enum IntakeMethod {
  BACK_OFFICE
  WHATSAPP
  PA_ENTRY
  FIELD_ENTRY
  ONLINE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  YET_TO_COMPLETE
}

enum GrievanceType {
  PATIENT_ISSUE
  INDIVIDUAL_ISSUE
  JOB_REQUEST
  TTD_REQUEST
  OTHER
}

// ==========================================
// PHASE 1: REAL-WORLD CONSTITUENCY PLATFORM MODELS
// ==========================================

// 1. Geography: Mandals & Villages
model Mandal {
  id           String            @id @default(cuid())
  name         String            @unique
  district     String            @default("Peddapalli")
  code         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  villages     Village[]
  leaders      LocalLeader[]
  works        PublicWork[]
  petitions    PetitionRequest[]
  partyWorkers PartyWorker[]
  booths       PollingBooth[]
}

model Village {
  id          String            @id @default(cuid())
  name        String
  mandalId    String
  mandal      Mandal            @relation(fields: [mandalId], references: [id], onDelete: Cascade)
  pincode     String?
  population  Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  leaders      LocalLeader[]
  works        PublicWork[]
  petitions    PetitionRequest[]
  partyWorkers PartyWorker[]

  @@unique([name, mandalId])
}

// 2. Local Leaders (The Quick-Glance Memory Feature)
model LocalLeader {
  id               String            @id @default(cuid())
  name             String
  phone            String            @db.VarChar(32)
  email            String?
  designation      String            // e.g. "Sarpanch", "MPTC Member", "Ward Member", "Youth Leader"
  partyRole        String?           // e.g. "Village President", "Mandal In-charge"
  photoUrl         String?
  mandalId         String?
  mandal           Mandal?           @relation(fields: [mandalId], references: [id])
  villageId        String?
  village          Village?          @relation(fields: [villageId], references: [id])
  villageName      String?
  mandalName       String?
  notes            String?           // General background notes about the leader
  privateNotes     String?           // Confidential notes for Minister & PA only
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  referredRequests PetitionRequest[] @relation("ReferredByLeader")
  referredWorks    PublicWork[]      @relation("RequestedByLeader")
}

// 3. Petitions & Requests (Replacing Paper Slips)
enum PetitionType {
  CMRF_MEDICAL        // Chief Minister Relief Fund / Urgent Medical
  JOB_EMPLOYMENT      // Job & Skill Requests
  EMPLOYEE_TRANSFER   // Government Employee Transfer / Posting
  SCHEME_FINANCIAL    // Financial Aid / Welfare Scheme
  PERSONAL_GRIEVANCE  // Land, Certificate, Pension, Family Issue
  VILLAGE_WORK        // Small village request
  TTD_DARSHAN         // Temple Darshan & Accommodation
  OTHER
}

enum PetitionStatus {
  PENDING
  SUBMITTED_TO_PA
  ASSIGNED_TO_OFFICIAL
  UNDER_REVIEW
  SANCTIONED
  RESOLVED
  REJECTED
  CLOSED
}

model PetitionRequest {
  id                     String            @id @default(cuid())
  trackingNumber         String            @unique // e.g. REQ-CMRF-2026-001
  type                   PetitionType      @default(PERSONAL_GRIEVANCE)
  title                  String
  description            String
  priority               Priority          @default(MEDIUM)
  status                 PetitionStatus    @default(PENDING)

  // 1. Citizen / Applicant Details
  applicantName          String
  applicantPhone         String            @db.VarChar(32)
  applicantAadhar        String?
  applicantAddress       String?
  district               String?           @default("Peddapalli")
  mandalId               String?
  mandal                 Mandal?           @relation(fields: [mandalId], references: [id])
  villageId              String?
  village                Village?          @relation(fields: [villageId], references: [id])
  mandalName             String?
  villageName            String?

  // 2. Local Leader Referral (Who brought this person/case)
  referredByLeaderId     String?
  referredByLeader       LocalLeader?      @relation("ReferredByLeader", fields: [referredByLeaderId], references: [id])
  referredByLeaderName   String?
  leaderEndorsementNote  String?

  // 3. PA Handling the file
  handlingPaId           String?
  handlingPa             User?             @relation("HandlingPA", fields: [handlingPaId], references: [id])
  handlingPaName         String?

  // 4. Official / Department it is assigned to
  assignedOfficialId     String?
  assignedOfficial       User?             @relation("AssignedOfficial", fields: [assignedOfficialId], references: [id])
  assignedOfficialName   String?
  assignedDepartment     String?           // e.g. "Revenue / MRO", "Health Dept", "Panchayat Raj"

  // 5. Private Internal Notes (Visible ONLY to Minister & PA)
  privateNotes           String?

  // Category-specific details
  hospitalName           String?           // For CMRF / Medical
  medicalCondition       String?           // For CMRF / Medical
  requestedAmount        Float?            // For CMRF / Financial Aid
  sanctionedAmount       Float?            // Amount approved by Minister / Govt
  currentPosting         String?           // For Employee Transfers
  requestedPosting       String?           // For Employee Transfers
  employeeDesignation    String?           // For Employee Transfers
  qualification          String?           // For Job Requests
  skillsOrResumeNotes    String?           // For Job Requests

  // Timers & Follow-up tracking
  daysAllowed            Int?              @default(7)
  isOverdue              Boolean           @default(false)
  dueDate                DateTime?
  lastFollowUpAt         DateTime?         @default(now())
  resolvedAt             DateTime?
  qrCode                 String?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  timeline               RequestTimeline[]
  attachments            FileAttachment[]
}

// Follow-up history / timeline for every action taken on a petition
model RequestTimeline {
  id                 String           @id @default(cuid())
  petitionRequestId  String
  petition           PetitionRequest  @relation(fields: [petitionRequestId], references: [id], onDelete: Cascade)
  fromStatus         PetitionStatus?
  toStatus           PetitionStatus
  actionTaken        String           // e.g. "Sent endorsement letter to District Collector", "Spoke to DMHO"
  remarks            String?
  performedByName    String           // e.g. "PA Srinivas"
  performedByRole    String           // e.g. "PA", "OFFICIAL", "MINISTER"
  isPrivateNote      Boolean          @default(false) // True if visible only to Minister/PA
  createdAt          DateTime         @default(now())
}

// 4. Public Works & Constituency Tracking
enum WorkCategory {
  ROADS_BRIDGES
  DRINKING_WATER
  EDUCATION_SCHOOLS
  HEALTH_CLINICS
  ELECTRICITY_LIGHTS
  COMMUNITY_HALL
  DRAINAGE_SANITATION
  IRRIGATION_LAKES
  OTHER
}

enum WorkStage {
  PLANNED
  PROPOSED
  SANCTIONED
  TENDER_STAGE
  IN_PROGRESS
  COMPLETED
  STUCK_DELAYED
}

model PublicWork {
  id                    String            @id @default(cuid())
  workCode              String            @unique // e.g. WRK-RD-2026-001
  title                 String            // e.g. "BT Road from Main Road to Harijanawada"
  description           String?
  category              WorkCategory      @default(ROADS_BRIDGES)
  stage                 WorkStage         @default(PLANNED)

  // Location
  district              String            @default("Peddapalli")
  mandalId              String?
  mandal                Mandal?           @relation(fields: [mandalId], references: [id])
  villageId             String?
  village               Village?          @relation(fields: [villageId], references: [id])
  mandalName            String?
  villageName           String?
  wardNumber            String?

  // Financials
  estimatedBudget       Float?
  sanctionedBudget      Float?
  spentBudget           Float?            @default(0)

  // Dates
  sanctionedDate        DateTime?
  targetCompletionDate  DateTime?
  actualCompletionDate  DateTime?

  // People & Roles
  requestedByLeaderId   String?
  requestedByLeader     LocalLeader?      @relation("RequestedByLeader", fields: [requestedByLeaderId], references: [id])
  requestedByLeaderName String?
  handlingPaId          String?
  handlingPa            User?             @relation("WorkHandlingPA", fields: [handlingPaId], references: [id])
  handlingPaName        String?
  supervisingOfficial   String?           // e.g. "EE Panchayat Raj Sri Ramana"
  executingDepartment   String?           // e.g. "Roads & Buildings (R&B)"
  contractorName        String?
  contractorPhone       String?

  // Private Internal Notes
  privateNotes          String?
  stuckReason           String?           // If delayed, why? (e.g. "Forest clearance pending")

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  milestones            WorkTimeline[]
  attachments           FileAttachment[]
}

// Work Milestones & Progress Log
model WorkTimeline {
  id              String       @id @default(cuid())
  publicWorkId    String
  publicWork      PublicWork   @relation(fields: [publicWorkId], references: [id], onDelete: Cascade)
  stage           WorkStage
  percentageDone  Int          @default(0) // 0 to 100%
  updateNote      String       // e.g. "Earth work completed, laying gravel started"
  updatedByName   String
  updatedByRole   String
  createdAt       DateTime     @default(now())
}

// 5. Attachments (Petitions, Letters, Photos)
model FileAttachment {
  id                 String           @id @default(cuid())
  fileName           String
  originalName       String
  fileUrl            String
  fileType           String           // e.g. "HANDWRITTEN_PETITION", "SANCTION_ORDER", "WORK_PROGRESS_PHOTO", "MEDICAL_BILL"
  mimeType           String?
  fileSize           Int?
  uploadedByName     String?
  petitionRequestId  String?
  petitionRequest    PetitionRequest? @relation(fields: [petitionRequestId], references: [id], onDelete: Cascade)
  publicWorkId       String?
  publicWork         PublicWork?      @relation(fields: [publicWorkId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
}

// 6. Minister's Calendar & Tour Schedule
enum TourEventType {
  VILLAGE_TOUR
  GRIEVANCE_DAY
  DEPARTMENT_REVIEW
  VIP_MEETING
  PUBLIC_MEETING
  PRESS_CONFERENCE
  OTHER
}

model TourAppointment {
  id               String         @id @default(cuid())
  title            String
  description      String?
  eventType        TourEventType  @default(VILLAGE_TOUR)
  startDate        DateTime
  endDate          DateTime?
  location         String
  mandalName       String?
  villageName      String?
  linkedLeaderId   String?
  linkedLeaderName String?
  vipGuests        String?
  status           String         @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED
  notes            String?
  privateNotes     String?        // Minister/PA only
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ==========================================
// LETTERS MANAGEMENT MODULE
// ==========================================

enum LetterDirection {
  INBOUND   // Received by the office
  OUTBOUND  // Sent from the office
}

enum LetterStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  RECEIVED
  ACKNOWLEDGED
  FILED
  CANCELLED
}

enum LetterType {
  DO_LETTER          // Demi-Official
  OFFICIAL_LETTER    // Formal government letter
  RECOMMENDATION     // Sifarish / endorsement letter
  REPRESENTATION     // Representation to department
  NOTICE             // Legal / official notice
  CIRCULAR           // Circular to staff/departments
  MEMO               // Internal memo
  OTHER
}

model Letter {
  id               String          @id @default(cuid())
  letterNumber     String          @unique // e.g. LTR-OUT-2026-0001
  direction        LetterDirection @default(OUTBOUND)
  letterType       LetterType      @default(OFFICIAL_LETTER)
  status           LetterStatus    @default(DRAFT)
  subject          String
  body             String?         // Full letter body / draft text
  priority         Priority        @default(MEDIUM)

  // From party
  fromName         String
  fromDesignation  String?
  fromDepartment   String?
  fromAddress      String?

  // To party
  toName           String
  toDesignation    String?
  toDepartment     String?
  toAddress        String?

  // Dispatch / receipt tracking
  letterDate       DateTime        @default(now())
  dueDate          DateTime?       // Expected response / action by date
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  acknowledgedAt   DateTime?

  // Links to other entities
  linkedPetitionId String?         // Link to PetitionRequest
  linkedWorkId     String?         // Link to PublicWork

  // Barcode / reference for physical tracking
  barcodeRef       String?
  fileUrl          String?         // Scanned copy URL

  // Staff
  draftedById      String          // User who created/drafted
  draftedByName    String
  approvedById     String?         // User who approved (PA/Minister)
  approvedByName   String?

  // Internal notes (Minister/PA only)
  privateNotes     String?

  // ── PESHI / SECRETARIAT FIELDS ──────────────────────────────────────────
  fileNumber              String?   // Physical file no. e.g. "GO/RT/123/2026" or e-Office ref
  eOfficeRef              String?   // e-Office system reference number
  endorsementText         String?   // Minister's handwritten instruction e.g. "Please examine and do the needful"
  endorsedById            String?   // User ID of Minister/PA who endorsed
  endorsedByName          String?   // Denormalised name
  endorsedAt              DateTime? // When endorsement was added
  recipientAcknowledgedBy String?   // Name of person at receiving office who acknowledged
  recipientAcknowledgedAt DateTime? // When they acknowledged receipt
  currentlyWithName       String?   // Which officer/desk currently holds this file
  currentlyWithDept       String?   // Which department currently holds this file
  expectedReplyBy         DateTime? // Deadline for reply from recipient department

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  timeline         LetterTimeline[]
}

model LetterTimeline {
  id              String       @id @default(cuid())
  letterId        String
  letter          Letter       @relation(fields: [letterId], references: [id], onDelete: Cascade)
  fromStatus      LetterStatus?
  toStatus        LetterStatus
  actionTaken     String
  remarks         String?
  performedByName String
  performedByRole String
  createdAt       DateTime     @default(now())
}

// ==========================================
// PARTY POST MANAGEMENT MODULE
// ==========================================

enum PartyPostLevel {
  STATE
  DISTRICT
  ASSEMBLY
  MANDAL
  VILLAGE
  BOOTH
}

model PartyPost {
  id          String         @id @default(cuid())
  title       String         // e.g. "Mandal President", "Youth Wing Secretary"
  wing        String?        // e.g. "Youth Wing", "Women Wing", "Main Party"
  level       PartyPostLevel @default(MANDAL)
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workers     PartyWorker[]

  @@unique([title, level, wing])
}

// ==========================================
// PARTY WORKERS MANAGEMENT MODULE
// ==========================================

enum WorkerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model PartyWorker {
  id               String        @id @default(cuid())
  name             String
  phone            String        @db.VarChar(32)
  whatsappPhone    String?       @db.VarChar(32)
  email            String?
  photoUrl         String?
  dateOfBirth      DateTime?
  gender           String?       // MALE / FEMALE / OTHER

  // Party post / designation
  partyPostId      String?
  partyPost        PartyPost?    @relation(fields: [partyPostId], references: [id])
  postTitle        String?       // denormalised for quick display
  wing             String?       // Youth Wing, Women Wing, Main Party, etc.

  // Geo scope — which area this worker is responsible for
  level            PartyPostLevel @default(MANDAL)
  district         String?        @default("Peddapalli")
  mandalId         String?
  mandal           Mandal?        @relation(fields: [mandalId], references: [id])
  mandalName       String?
  villageId        String?
  village          Village?       @relation(fields: [villageId], references: [id])
  villageName      String?
  boothNumber      String?        // Polling booth number if booth-level worker

  // Status & activity
  status           WorkerStatus   @default(ACTIVE)
  joinedPartyOn    DateTime?
  lastActiveAt     DateTime?
  voterId          String?        // EPIC / Voter ID
  aadharLast4      String?        // last 4 digits only

  // Notes
  notes            String?
  privateNotes     String?        // Minister/PA only

  // Audit
  addedById        String?        // User who added this record
  addedByName      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ==========================================
// MODULE: MULTIPLE OFFICE MANAGEMENT
// ==========================================

enum OfficeType {
  SECRETARIAT       // Hyderabad / capital office
  CONSTITUENCY      // Home constituency camp office
  RESIDENCE         // Minister's residence office
  DISTRICT          // District-level office
  OTHER
}

model Office {
  id           String     @id @default(cuid())
  name         String     // e.g. "Hyderabad Secretariat", "Peddapalli Camp Office"
  officeType   OfficeType @default(CONSTITUENCY)
  address      String?
  city         String?
  phone        String?    @db.VarChar(32)
  email        String?
  inChargeName String?    // Officer in charge
  isActive     Boolean    @default(true)
  isDefault    Boolean    @default(false) // Only one office can be default
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tasks        Task[]
}

// ==========================================
// MODULE: TASKS (MULTI-OFFICE AWARE)
// ==========================================

enum TaskStatus {
  OPEN
  IN_PROGRESS
  PENDING_INFO
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id               String      @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus  @default(OPEN)
  priority         TaskPriority @default(MEDIUM)

  // Office routing
  officeId         String?
  office           Office?     @relation(fields: [officeId], references: [id])
  officeName       String?     // denormalised

  // Assignment
  assignedToId     String?     // User ID
  assignedToName   String?
  assignedToRole   String?
  createdById      String
  createdByName    String
  createdByRole    String

  // Linked entities
  linkedPetitionId String?
  linkedWorkId     String?
  linkedLetterId   String?

  // Deadlines & escalation
  dueDate          DateTime?
  completedAt      DateTime?
  isOverdue        Boolean    @default(false)

  // Voice note transcription (AI)
  voiceNoteUrl     String?
  transcription    String?

  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// ==========================================
// MODULE: CONSTITUENCY SURVEY + BOOTH GRADING
// ==========================================

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum QuestionType {
  YES_NO
  RATING_1_5
  MULTIPLE_CHOICE
  TEXT
}

model Survey {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        SurveyStatus @default(DRAFT)
  targetLevel   String       @default("BOOTH") // BOOTH / VILLAGE / MANDAL
  languages     Json?        // ["te", "hi", "en"] — supported languages
  startsAt      DateTime?
  endsAt        DateTime?
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  questions     SurveyQuestion[]
  responses     SurveyResponse[]
  boothGrades   BoothGrade[]
}

model SurveyQuestion {
  id           String       @id @default(cuid())
  surveyId     String
  survey       Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  orderIndex   Int          @default(0)
  questionType QuestionType @default(YES_NO)
  questionText String       // English
  questionTe   String?      // Telugu
  questionHi   String?      // Hindi
  options      Json?        // For MULTIPLE_CHOICE: ["Option A", "Option B"]
  isRequired   Boolean      @default(true)
  weight       Float        @default(1.0) // For booth grading score calculation
  createdAt    DateTime     @default(now())
}

model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  survey         Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  // Geo scope of this response
  boothNumber    String?
  villageName    String?
  mandalName     String?
  district       String?  @default("Peddapalli")

  // Respondent (citizen — optional, can be anonymous)
  respondentName  String?
  respondentPhone String?  @db.VarChar(32)
  voterId         String?

  // Answers: { questionId: answer } stored as JSON
  answers        Json

  // Collected by
  collectedById   String?
  collectedByName String?
  collectedAt     DateTime @default(now())

  // GPS at time of collection
  latitude        Float?
  longitude       Float?

  createdAt       DateTime @default(now())
}

// Nightly computed booth grade — updated by cron / on-demand
model BoothGrade {
  id                    String   @id @default(cuid())
  surveyId              String
  survey                Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  boothNumber           String
  villageName           String?
  mandalName            String?

  // Scoring components (0-100 each)
  schemePenetrationScore  Float  @default(0)
  grievanceResolutionScore Float @default(0)
  surveysentimentScore    Float  @default(0)
  totalScore              Float  @default(0)

  // Grade: A=Stronghold, B=Leaning, C=Swing, D=Critical
  grade                 String   @default("C")
  previousGrade         String?
  gradeDrop             Boolean  @default(false) // true if dropped since last compute

  responseCount         Int      @default(0)
  computedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([surveyId, boothNumber])
}

// ==========================================
// MODULE: MPLADS / MLACDS FUND TRACKING
// ==========================================

enum FundScheme {
  MPLADS    // Member of Parliament Local Area Development Scheme
  MLACDS    // MLA Constituency Development Scheme
  STATE     // State government discretionary fund
  OTHER
}

enum FundAllocationStatus {
  RECOMMENDED           // Minister recommended, letter sent
  LETTER_SENT           // Letter sent to Collector
  ADMIN_SANCTION        // Administrative Sanction issued
  TECH_SANCTION         // Technical Sanction issued
  TENDER_FLOATED        // Tender process started
  WORK_IN_PROGRESS      // Construction / work started
  COMPLETED             // Work completed
  CANCELLED             // Cancelled / lapsed
}

model FundAllocation {
  id                   String              @id @default(cuid())
  referenceNumber      String              @unique // e.g. FUND-MLACDS-2026-001
  scheme               FundScheme          @default(MLACDS)
  financialYear        String              // e.g. "2025-26"
  status               FundAllocationStatus @default(RECOMMENDED)

  // What the fund is for
  workTitle            String
  workDescription      String?
  category             String?             // Roads, Water, Education, etc.

  // Location
  district             String              @default("Peddapalli")
  mandalName           String?
  villageName          String?
  wardNumber           String?

  // Financials
  recommendedAmount    Float
  sanctionedAmount     Float?
  releasedAmount       Float?              @default(0)
  utilizedAmount       Float?              @default(0)

  // Bureaucratic stage tracking (Rule 6 equivalent for funds)
  recommendationDate   DateTime?           // Stage 1: Letter sent
  adminSanctionDate    DateTime?           // Stage 2: AS issued
  techSanctionDate     DateTime?           // Stage 3: TS issued
  tenderDate           DateTime?           // Stage 3b: Tender floated
  firstInstallmentDate DateTime?           // Stage 4a
  finalInstallmentDate DateTime?           // Stage 4b
  completionDate       DateTime?

  // Linked project
  linkedProjectId      String?             // Link to GovernmentProject

  // Stuck alert
  isStuck              Boolean             @default(false)
  stuckReason          String?
  stuckSince           DateTime?

  // People
  recommendedById      String
  recommendedByName    String
  collectorOffice      String?             // District Collector office reference
  executingAgency      String?             // e.g. "Panchayat Raj", "R&B"

  notes                String?
  privateNotes         String?             // Minister/PA only

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  timeline             FundTimeline[]
}

model FundTimeline {
  id               String              @id @default(cuid())
  fundAllocationId String
  fundAllocation   FundAllocation      @relation(fields: [fundAllocationId], references: [id], onDelete: Cascade)
  fromStatus       FundAllocationStatus?
  toStatus         FundAllocationStatus
  actionTaken      String
  remarks          String?
  performedByName  String
  performedByRole  String
  createdAt        DateTime            @default(now())
}

// ==========================================
// MODULE: LIVING CONSTITUENCY GRAPH
// Citizen + Household + PollingBooth
// ==========================================

model PollingBooth {
  id           String      @id @default(cuid())
  boothNumber  String      // e.g. "42"
  boothName    String?     // Official booth name
  address      String?
  mandalId     String?
  mandal       Mandal?     @relation(fields: [mandalId], references: [id])
  mandalName   String?
  villageName  String?
  district     String      @default("Peddapalli")
  totalVoters  Int?        // From ECI data
  maleVoters   Int?
  femaleVoters Int?
  otherVoters  Int?
  // Grade from survey engine
  currentGrade String?     // A/B/C/D
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  households   Household[]
  citizens     Citizen[]

  @@unique([boothNumber, mandalId])
}

model Household {
  id            String       @id @default(cuid())
  houseNumber   String?      // House number from ECI roll
  address       String?
  streetColony  String?
  villageName   String?
  mandalName    String?
  district      String       @default("Peddapalli")
  boothId       String?
  booth         PollingBooth? @relation(fields: [boothId], references: [id])
  boothNumber   String?
  // Scheme benefits received by this household
  schemeBenefits Json?       // { "PM_AWAS": true, "RYTHU_BANDHU": false, ... }
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  citizens      Citizen[]
}

enum CitizenGender {
  MALE
  FEMALE
  OTHER
}

model Citizen {
  id              String        @id @default(cuid())
  // ECI Electoral Roll fields
  epicNumber      String?       @unique // Voter ID / EPIC
  name            String
  fatherOrHusband String?       // Father's / Husband's name (from ECI roll)
  age             Int?
  gender          CitizenGender?
  // Address / Geo
  houseNumber     String?
  streetColony    String?
  villageName     String?
  mandalName      String?
  district        String        @default("Peddapalli")
  pincode         String?
  boothId         String?
  booth           PollingBooth? @relation(fields: [boothId], references: [id])
  boothNumber     String?
  householdId     String?
  household       Household?    @relation(fields: [householdId], references: [id])
  // Enrichment (added over time via camp office / survey)
  phone           String?       @db.VarChar(32)
  whatsappOptIn   Boolean       @default(false)
  aadharLast4     String?       // last 4 digits only
  // Scheme benefits
  schemeBenefits  Json?         // { "PM_AWAS": true, "RYTHU_BANDHU": false, ... }
  // Interaction history
  lastInteraction DateTime?
  interactionCount Int          @default(0)
  // Source of record
  dataSource      String        @default("ECI_ROLL") // ECI_ROLL / CAMP_OFFICE / SURVEY / MANUAL
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ==========================================
// MODULE: OUTBOUND CAMPAIGNS (WhatsApp / SMS)
// ==========================================

enum CampaignChannel {
  WHATSAPP
  SMS
  BOTH
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id               String         @id @default(cuid())
  title            String
  messageTemplate  String         // Template with {{Citizen_Name}}, {{Work_Status}} etc.
  channel          CampaignChannel @default(WHATSAPP)
  status           CampaignStatus  @default(DRAFT)
  // Targeting segment (stored as a query descriptor)
  segmentQuery     Json?          // { mandal: "Manthani", scheme: "PM_AWAS", boothGrade: "D" }
  segmentLabel     String?        // Human-readable: "Ward 8 water grievance citizens"
  recipientCount   Int            @default(0)
  sentCount        Int            @default(0)
  deliveredCount   Int            @default(0)
  failedCount      Int            @default(0)
  // Two-key approval
  createdById      String
  createdByName    String
  approvedById     String?
  approvedByName   String?
  approvedAt       DateTime?
  scheduledAt      DateTime?
  sentAt           DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deliveries       CampaignDelivery[]
}

model CampaignDelivery {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  phone        String   @db.VarChar(32)
  citizenName  String?
  citizenId    String?  // Link to Citizen if matched
  message      String   // Rendered message with variables substituted
  status       String   @default("PENDING") // PENDING / SENT / DELIVERED / READ / FAILED
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime @default(now())
}

// ==========================================
// MODULE: ASSEMBLY QUESTIONS (LAQ / LCQ)
// Tracks Legislative Assembly Questions related to the Minister's portfolio
// ==========================================

enum AQType {
  STARRED       // Oral answer required in Assembly
  UNSTARRED     // Written answer submitted
  SHORT_NOTICE  // Urgent / short-notice question
  CALLING_ATTENTION // Calling attention motion
}

enum AQStatus {
  RECEIVED        // Question received from Assembly Secretariat
  SENT_TO_DEPT    // Forwarded to concerned department for answer
  DRAFT_RECEIVED  // Draft answer received from department
  UNDER_REVIEW    // PA / Minister reviewing the draft
  ANSWER_READY    // Final answer approved
  ANSWERED        // Answered in Assembly
  LAPSED          // Session ended without being called
}

model AssemblyQuestion {
  id                  String    @id @default(cuid())
  questionNumber      String    @unique  // e.g. "LAQ-2026-0142"
  sessionName         String             // e.g. "Budget Session 2026"
  questionType        AQType    @default(STARRED)
  status              AQStatus  @default(RECEIVED)

  // Question details
  subject             String             // One-line subject
  questionText        String             // Full question text
  askedByMLA          String             // MLA name who raised the question
  askedByConstituency String?            // MLA's constituency
  ministry            String             // Which ministry this falls under
  department          String?            // Specific department

  // Dates
  receivedDate        DateTime  @default(now())
  answerDueDate       DateTime?          // Deadline to submit answer to Assembly
  answeredDate        DateTime?          // When actually answered

  // Answer tracking
  sentToDeptAt        DateTime?
  sentToDeptName      String?            // Which dept it was sent to
  draftReceivedAt     DateTime?
  draftAnswerText     String?            // Draft from department
  finalAnswerText     String?            // Approved final answer
  talkingPoints       String?            // AI-generated bullet points for Minister

  // Links
  linkedPetitionId    String?            // If question relates to a citizen petition
  linkedWorkId        String?            // If question relates to a public work
  linkedLetterId      String?            // If a letter was sent as part of answer
  fileUrl             String?            // Scanned question paper / answer document

  // Staff
  handledById         String?            // PA/ADMIN handling this
  handledByName       String?
  privateNotes        String?            // Minister/PA only

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  timeline            AQTimeline[]
}

model AQTimeline {
  id                  String           @id @default(cuid())
  assemblyQuestionId  String
  question            AssemblyQuestion @relation(fields: [assemblyQuestionId], references: [id], onDelete: Cascade)
  fromStatus          AQStatus?
  toStatus            AQStatus
  actionTaken         String
  remarks             String?
  performedByName     String
  performedByRole     String
  createdAt           DateTime         @default(now())
}
